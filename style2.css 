/* ==========================================================================
   Configurações Base e Variáveis
   ========================================================================== */
:root {
  /* Paleta de Cores Neutras de Alto Contraste */
  --bg-primary: #f8f9fa;
  --bg-surface: #ffffff;
  --bg-subtle: #e9ecef;
  
  --text-main: #1a1d20;
  --text-muted: #495057;
  
  --border-color: #ced4da;
  --focus-ring: #0d6efd; /* Azul de alto contraste para o foco do teclado */
  --accent-color: #2b3035;

  /* Fontes e Tamanhos */
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-size-base: 1rem; /* 16px por padrão */
}

/* Permitir escalonamento fácil via Javascript */
html {
  font-size: 100%; /* Respeita a preferência do navegador */
  box-sizing: border-box;
}

*, *::before, *::after {
  box-sizing: inherit;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-family);
  background-color: var(--bg-primary);
  color: var(--text-main);
  line-height: 1.6;
}

.container {
  width: 90%;
  max-width: 1000px;
  margin: 0 auto;
}

/* ==========================================================================
   Acessibilidade e Foco
   ========================================================================== */
/* Link invisível para saltar direto ao conteúdo */
.skip-link {
  position: absolute;
  top: -40px;
  left: 10px;
  background: var(--text-main);
  color: var(--bg-surface);
  padding: 8px 16px;
  z-index: 100;
  text-decoration: none;
  font-weight: bold;
  border-radius: 4px;
}

.skip-link:focus {
  top: 10px;
}

/* Indicador visual de foco bem definido */
a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--focus-ring);
  outline-offset: 3px;
  border-radius: 2px;
}

/* ==========================================================================
   Barra de Acessibilidade
   ========================================================================== */
.top-bar {
  background-color: var(--accent-color);
  color: var(--bg-surface);
  padding: 0.5rem 0;
}

.top-bar-content {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 1rem;
}

.font-controls button {
  background: var(--bg-surface);
  color: var(--text-main);
  border: 1px solid var(--border-color);
  padding: 0.3rem 0.6rem;
  font-weight: bold;
  cursor: pointer;
  border-radius: 4px;
}

.font-controls button:hover {
  background-color: var(--bg-subtle);
}

/* ==========================================================================
   Cabeçalho e Navegação
   ========================================================================== */
.main-header {
  background-color: var(--bg-surface);
  border-bottom: 2px solid var(--border-color);
  padding: 1rem 0;
}

.header-flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.logo a {
  font-size: 1.5rem;
  color: var(--text-main);
  text-decoration: none;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.nav-links a {
  color: var(--text-main);
  text-decoration: underline;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--text-muted);
}

/* ==========================================================================
   Seções de Conteúdo
   ========================================================================== */
.hero-section {
  padding: 3rem 0 2rem 0;
}

h1 {
  font-size: 2.25rem;
  margin-bottom: 0.8rem;
  line-height: 1.2;
}

.lead {
  font-size: 1.2rem;
  color: var(--text-muted);
}

.info-section {
  padding: 2rem 0;
}

h2 {
  font-size: 1.75rem;
  border-bottom: 2px solid var(--border-color);
  padding-bottom: 0.5rem;
  margin-top: 2rem;
}

.accessible-image {
  margin: 2rem 0;
  text-align: center;
}

.accessible-image img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.accessible-image figcaption {
  margin-top: 0.5rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* Grid de Cards */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1.5rem;
}

.card h3 {
  margin-top: 0;
}

/* Rodapé */
.main-footer {
  margin-top: 4rem;
  padding: 2rem 0;
  background-color: var(--bg-subtle);
  border-top: 1px solid var(--border-color);
  text-align: center;
  color: var(--text-muted);
}